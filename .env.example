# Copy to .env.local (git-ignored) and fill in. Never commit tokens.
# Catalogue endpoints per MapColonies environment (defaults shown).
VITE_MAPCOLONIES_CSW_URL="https://catalog.mapcolonies.net/api/3d/v1/csw"
VITE_MAPCOLONIES_CSW_URL_INT="https://catalog-int.mapcolonies.net/api/3d/v1/csw"
VITE_MAPCOLONIES_CSW_URL_DEV="https://catalog-dev.mapcolonies.net/api/3d/v1/csw"
# Token (shared), optionally overridden per environment.
VITE_MAPCOLONIES_TOKEN=""
VITE_MAPCOLONIES_TOKEN_INT=""
VITE_MAPCOLONIES_TOKEN_DEV=""
# Optional default environment for new browsers: prod | int | dev
VITE_MAPCOLONIES_ENV="prod"
